{
  "description": "Super-Skill V5 plugin hooks. Every script is fail-open and a no-op outside projects that contain .super-skill/state.json. If you also ran install.py --hooks, uninstall one of the two (python install.py --uninstall-hooks) to avoid double execution.",
  "hooks": {
    "SessionStart": [
      {"matcher": "startup|resume|clear|compact", "hooks": [{"type": "command", "timeout": 30,
        "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/skills/super-skill/hooks/session_start.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/.claude/skills/super-skill/hooks/session_start.py\""}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "timeout": 10,
        "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/skills/super-skill/hooks/user_prompt.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/.claude/skills/super-skill/hooks/user_prompt.py\""}]}
    ],
    "PreToolUse": [
      {"matcher": "Bash|PowerShell|Read|Edit|Write|MultiEdit|NotebookEdit", "hooks": [{"type": "command", "timeout": 15,
        "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/skills/super-skill/hooks/pre_tool.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/.claude/skills/super-skill/hooks/pre_tool.py\""}]}
    ],
    "PostToolUse": [
      {"matcher": "", "hooks": [{"type": "command", "timeout": 15,
        "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/skills/super-skill/hooks/post_tool.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/.claude/skills/super-skill/hooks/post_tool.py\""}]}
    ],
    "PreCompact": [
      {"matcher": "manual|auto", "hooks": [{"type": "command", "timeout": 30,
        "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/skills/super-skill/hooks/pre_compact.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/.claude/skills/super-skill/hooks/pre_compact.py\""}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "timeout": 30,
        "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/skills/super-skill/hooks/stop_gate.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/.claude/skills/super-skill/hooks/stop_gate.py\""}]}
    ],
    "SubagentStop": [
      {"hooks": [{"type": "command", "timeout": 10,
        "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/skills/super-skill/hooks/log_event.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/.claude/skills/super-skill/hooks/log_event.py\""}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "timeout": 5,
        "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/skills/super-skill/hooks/log_event.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/.claude/skills/super-skill/hooks/log_event.py\""}]}
    ]
  }
}
