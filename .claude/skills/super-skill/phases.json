{
  "schema_version": "1.0",
  "_doc": "Machine-readable phase contracts (V5). Each gate check is run by engine/gate_check.py. severity=error blocks advance; warn is reported only. Paths are relative to the project root. Human-readable detail lives in references/phases.md.",
  "phases": [
    {
      "id": "IF1", "name": "Idea Intake", "skill": "idea-intake", "front": true, "autonomous": false,
      "outputs": ["IDEA_SEED.md"],
      "gate": [
        {"type": "file_exists", "path": "IDEA_SEED.md"},
        {"type": "min_bytes", "path": "IDEA_SEED.md", "min": 200}
      ]
    },
    {
      "id": "IF2", "name": "Research Orchestrator", "skill": "research-orchestrator", "front": true, "autonomous": true,
      "outputs": ["RESEARCH_DIGEST.md", "GAP_REPORT.md"],
      "gate": [
        {"type": "file_exists", "path": "RESEARCH_DIGEST.md"},
        {"type": "file_exists", "path": "GAP_REPORT.md"},
        {"type": "min_bytes", "path": "RESEARCH_DIGEST.md", "min": 500}
      ]
    },
    {
      "id": "IF3", "name": "Proposal Forge", "skill": "proposal-forge", "front": true, "autonomous": false, "approval": "proposal",
      "outputs": ["PROPOSAL.md", "BUSINESS_MODEL.md", "SCORECARD.json"],
      "gate": [
        {"type": "file_exists", "path": "PROPOSAL.md"},
        {"type": "file_exists", "path": "SCORECARD.json"},
        {"type": "json_field", "path": "SCORECARD.json", "field": "verdict", "op": "in", "value": ["proceed"]},
        {"type": "file_exists", "path": "BUSINESS_MODEL.md", "severity": "warn"},
        {"type": "approval", "name": "proposal"}
      ]
    },
    {
      "id": "P0", "name": "Visionary Elevation", "skill": "darwin-evolution", "autonomous": true,
      "outputs": ["VISION.md", "AI_NATIVE_OPTIONS.md"],
      "gate": [
        {"type": "file_exists", "path": "VISION.md"},
        {"type": "min_bytes", "path": "VISION.md", "min": 300},
        {"type": "file_exists", "path": "AI_NATIVE_OPTIONS.md", "severity": "warn"},
        {"type": "no_marker", "paths": ["VISION.md"], "marker": "[NEEDS CLARIFICATION]"}
      ]
    },
    {
      "id": "P1", "name": "Feasibility Analysis", "skill": "feasibility-check", "autonomous": true,
      "outputs": ["FEASIBILITY_REPORT.md", "RISK_REGISTER.md"],
      "gate": [
        {"type": "file_exists", "path": "FEASIBILITY_REPORT.md"},
        {"type": "file_exists", "path": "RISK_REGISTER.md"},
        {"type": "regex_number", "path": "FEASIBILITY_REPORT.md", "pattern": "(?i)CC-FPS[^0-9\\n]{0,40}([01](?:\\.\\d+)?)", "min": 0.7, "severity": "warn"}
      ]
    },
    {
      "id": "P2", "name": "GitHub Discovery", "skill": "github-discovery", "autonomous": true,
      "outputs": ["GITHUB_DISCOVERY_REPORT.md"],
      "gate": [
        {"type": "file_exists", "path": "GITHUB_DISCOVERY_REPORT.md"},
        {"type": "regex_count", "path": "GITHUB_DISCOVERY_REPORT.md", "pattern": "github\\.com/[\\w.-]+/[\\w.-]+", "min": 3}
      ]
    },
    {
      "id": "P2b", "name": "Skills Discovery", "skill": "find-skills", "autonomous": true, "optional": true,
      "outputs": ["SKILLS_DISCOVERY.md"],
      "gate": [
        {"type": "file_exists", "path": "SKILLS_DISCOVERY.md", "severity": "warn"}
      ]
    },
    {
      "id": "P3", "name": "Knowledge Base", "skill": "continuous-learning-v2", "autonomous": true,
      "outputs": ["KNOWLEDGE_BASE/", "CONTEXT.md"],
      "gate": [
        {"type": "glob_count", "pattern": "KNOWLEDGE_BASE/**/*.md", "min": 1},
        {"type": "file_exists", "path": "CONTEXT.md"}
      ]
    },
    {
      "id": "P4", "name": "Requirements Engineering", "skill": "brainstorming", "autonomous": false, "approval": "requirements",
      "outputs": ["REQUIREMENTS.md"],
      "gate": [
        {"type": "file_exists", "path": "REQUIREMENTS.md"},
        {"type": "req_ids", "path": "REQUIREMENTS.md", "min": 1},
        {"type": "ears", "path": "REQUIREMENTS.md"},
        {"type": "no_marker", "paths": ["REQUIREMENTS.md"], "marker": "[NEEDS CLARIFICATION]"},
        {"type": "approval", "name": "requirements"}
      ]
    },
    {
      "id": "P5", "name": "Architecture & Design", "skill": "api-patterns", "autonomous": true,
      "outputs": ["ARCHITECTURE.md", "API_DESIGN.md"],
      "gate": [
        {"type": "file_exists", "path": "ARCHITECTURE.md"},
        {"type": "min_bytes", "path": "ARCHITECTURE.md", "min": 500},
        {"type": "file_exists", "path": "API_DESIGN.md", "severity": "warn"},
        {"type": "no_marker", "paths": ["ARCHITECTURE.md"], "marker": "[NEEDS CLARIFICATION]"}
      ]
    },
    {
      "id": "P6", "name": "Work Breakdown (WBS)", "skill": "real-engineering", "autonomous": true,
      "outputs": ["WBS.md", ".super-skill/tasks.json"],
      "gate": [
        {"type": "file_exists", "path": "WBS.md"},
        {"type": "taskgraph_valid"},
        {"type": "trace", "require": "tasks"}
      ]
    },
    {
      "id": "P7", "name": "Project Initialization", "skill": "cicd-automation", "autonomous": true,
      "outputs": [".git/", "test command in state.config.test_cmd"],
      "gate": [
        {"type": "git_repo"},
        {"type": "state_field", "field": "config.test_cmd", "op": "nonempty"},
        {"type": "command", "cmd_from": "config.test_cmd", "timeout": 600}
      ]
    },
    {
      "id": "P8", "name": "Autonomous Development", "skill": "autonomous-loop", "autonomous": true,
      "outputs": ["source code", "experiments.tsv"],
      "gate": [
        {"type": "tasks_done", "min_ratio": 1.0},
        {"type": "loop_guard_closed", "severity": "warn"},
        {"type": "command", "cmd_from": "config.test_cmd", "timeout": 1200}
      ]
    },
    {
      "id": "P9", "name": "Quality Assurance", "skill": "testing-automation", "autonomous": true,
      "outputs": ["QA_REPORT.md", ".super-skill/trace.md"],
      "gate": [
        {"type": "file_exists", "path": "QA_REPORT.md"},
        {"type": "trace", "require": "tests"},
        {"type": "command", "cmd_from": "config.test_cmd", "timeout": 1200}
      ]
    },
    {
      "id": "P10", "name": "Ralph Loop (Optimization)", "skill": "autonomous-loop", "autonomous": true,
      "outputs": ["RALPH_REPORT.md"],
      "gate": [
        {"type": "file_exists", "path": "RALPH_REPORT.md"},
        {"type": "loop_guard_closed", "severity": "warn"},
        {"type": "command", "cmd_from": "config.test_cmd", "timeout": 1200}
      ]
    },
    {
      "id": "P11", "name": "Deployment", "skill": "cicd-automation", "autonomous": true,
      "outputs": ["DEPLOYMENT.md"],
      "gate": [
        {"type": "file_exists", "path": "DEPLOYMENT.md"},
        {"type": "no_marker", "paths": ["DEPLOYMENT.md"], "marker": "[NEEDS CLARIFICATION]"}
      ]
    },
    {
      "id": "P12", "name": "Evolution", "skill": "post-run-evolution", "autonomous": true,
      "outputs": ["EVOLUTION_REPORT.md", ".super-skill/playbook.jsonl"],
      "gate": [
        {"type": "file_exists", "path": "EVOLUTION_REPORT.md"},
        {"type": "file_exists", "path": ".super-skill/playbook.jsonl", "severity": "warn"}
      ]
    }
  ]
}
